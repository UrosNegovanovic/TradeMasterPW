{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["config", "fixtures", "pages", "test-data", "tests", "utils", "*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
