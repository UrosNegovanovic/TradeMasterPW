# Copy to .env and fill in. Never commit .env.

# Target app (Vercel preview/prod URL or http://localhost:3000)
BASE_URL=https://trade-master-seven.vercel.app

# Clerk Development instance (https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# E2E test user (Clerk Development instance, *+clerk_test@... email)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_OTP=424242
# Second tenant for isolation tests (auto-created in Clerk Dev if missing)
E2E_USER_B_EMAIL=e2e-user-b+clerk_test@example.com
# Third tenant: company in the VAT system (invoice VAT tests)
E2E_USER_VAT_EMAIL=e2e-user-vat+clerk_test@example.com

# Comma-separated hosts treated as production (read-only tests). Add the real domain at launch.
PRODUCTION_HOSTS=

# Test DB only (never production). Used by SQL tests and fixtures.
TEST_DATABASE_URL=

# BrowserStack (test:browserstack*)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Percy (test:percy*)
PERCY_TOKEN=
